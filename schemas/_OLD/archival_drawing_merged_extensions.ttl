@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix archdrw: <https://archivingresearch.org/schema/drawing#> .
@prefix archgen: <https://archivingresearch.org/schema/drawing/extensions/generated#> .

<https://archivingresearch.org/schema/drawing/extensions/generated>
    a owl:Ontology ;
    rdfs:label "Generated Archival Drawing Extensions"@en ;
    rdfs:comment "Generated extension ontology from random S3 image analysis. Distinct from Dublin Core and base drawing ontology; references them via owl:imports."@en ;
    dcterms:creator "GitHub Copilot" ;
    dcterms:date "2026-04-11" ;
    owl:imports <http://purl.org/dc/terms/> ;
    owl:imports <https://archivingresearch.org/schema/drawing> ;
    owl:versionInfo "0.1.0" .

