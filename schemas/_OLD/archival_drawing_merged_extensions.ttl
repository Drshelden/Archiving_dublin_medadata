# ARCHDRW SCHEMA EXTENSIONS
# Merged from archival_drawing_revised_extended.ttl (v0.2)
# These terms extend the base archdrw: ontology with richer vocabulary for
# presentation boards, panel characterizations, urban analysis, and
# competition documents.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•


# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# PART I: ANALYTICAL / URBAN DESIGN PRESENTATION BOARDS
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ Classes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

archdrw:PresentationBoard
    a owl:Class ;
    rdfs:label "Presentation Board"@en ;
    rdfs:comment "A composed competition or studio board containing multiple panels, diagrams, maps, text blocks, legends, and graphic annotations arranged on a single sheet."@en ;
    rdfs:subClassOf archdrw:ArchivalDrawing .

archdrw:BoardComponent
    a owl:Class ;
    rdfs:label "Board Component"@en ;
    rdfs:comment "A discrete component within a presentation board, such as a panel, diagram, map, legend, text block, or inset."@en .

archdrw:Panel
    a owl:Class ;
    rdfs:label "Panel"@en ;
    rdfs:comment "A bounded visual region of a presentation board."@en ;
    rdfs:subClassOf archdrw:BoardComponent .

archdrw:InsetPanel
    a owl:Class ;
    rdfs:label "Inset Panel"@en ;
    rdfs:comment "A secondary zoomed or embedded panel placed within or over a larger panel."@en ;
    rdfs:subClassOf archdrw:Panel .

archdrw:MapPanel
    a owl:Class ;
    rdfs:label "Map Panel"@en ;
    rdfs:comment "A panel centered on cartographic or urban fabric representation."@en ;
    rdfs:subClassOf archdrw:Panel .

archdrw:DiagramPanel
    a owl:Class ;
    rdfs:label "Diagram Panel"@en ;
    rdfs:comment "A panel presenting abstract, schematic, or process-oriented diagrams."@en ;
    rdfs:subClassOf archdrw:Panel .

archdrw:TextBlock
    a owl:Class ;
    rdfs:label "Text Block"@en ;
    rdfs:comment "A prose or explanatory text region on a board."@en ;
    rdfs:subClassOf archdrw:BoardComponent .

archdrw:Legend
    a owl:Class ;
    rdfs:label "Legend"@en ;
    rdfs:comment "A key explaining symbols, colors, or categories used on a board."@en ;
    rdfs:subClassOf archdrw:BoardComponent .

archdrw:AbstractionSequence
    a owl:Class ;
    rdfs:label "Abstraction Sequence"@en ;
    rdfs:comment "A staged decomposition or transformation sequence, such as buildings â†’ blocks â†’ void â†’ abstract figure."@en ;
    rdfs:subClassOf archdrw:BoardComponent .

archdrw:UrbanEntity
    a owl:Class ;
    rdfs:label "Urban Entity"@en ;
    rdfs:comment "A city-scale object, structure, space, or region represented in a board."@en .

archdrw:UrbanAnomaly
    a owl:Class ;
    rdfs:label "Urban Anomaly"@en ;
    rdfs:comment "A non-conforming or exceptional urban condition identified analytically, such as a corridor, cut, discontinuity, or irregularity in the urban grid."@en ;
    rdfs:subClassOf archdrw:UrbanEntity .

archdrw:VoidSpace
    a owl:Class ;
    rdfs:label "Void Space"@en ;
    rdfs:comment "An extracted or identified absence, gap, residual corridor, or negative urban space."@en ;
    rdfs:subClassOf archdrw:UrbanEntity .

archdrw:UrbanGridCondition
    a owl:Class ;
    rdfs:label "Urban Grid Condition"@en ;
    rdfs:comment "A condition or reading of the street/grid structure, including regularity, irregularity, deviation, or compression."@en ;
    rdfs:subClassOf archdrw:UrbanEntity .

archdrw:ConnectivitySystem
    a owl:Class ;
    rdfs:label "Connectivity System"@en ;
    rdfs:comment "A circulation or linkage system represented in the board, including street, subway, rail, highway, landscape, or hydrological connections."@en ;
    rdfs:subClassOf archdrw:UrbanEntity .

archdrw:InfrastructureLayer
    a owl:Class ;
    rdfs:label "Infrastructure Layer"@en ;
    rdfs:comment "A represented infrastructural layer, such as underground transit, surface streets, or elevated transport."@en ;
    rdfs:subClassOf archdrw:UrbanEntity .

archdrw:LandscapeLayer
    a owl:Class ;
    rdfs:label "Landscape Layer"@en ;
    rdfs:comment "A represented ecological or open-space layer such as greenspace, waterfront, or topographic surface."@en ;
    rdfs:subClassOf archdrw:UrbanEntity .

archdrw:MapLayer
    a owl:Class ;
    rdfs:label "Map Layer"@en ;
    rdfs:comment "A semantic layer in a map-based representation, such as water, greenspace, urban fabric, anomalies, or infrastructure."@en .

archdrw:GraphicEncoding
    a owl:Class ;
    rdfs:label "Graphic Encoding"@en ;
    rdfs:comment "A visual encoding used to distinguish information, such as highlight color, line weight, hatch, opacity, or tonal contrast."@en .

# â”€â”€ Additional drawing type values â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

archdrw:AnalyticalBoard
    a archdrw:DrawingType ;
    rdfs:label "Analytical Board"@en ;
    skos:definition "A composed board devoted primarily to analysis, explanation, and synthesis rather than direct depiction alone."@en .

archdrw:UrbanAnalysisMap
    a archdrw:DrawingType ;
    rdfs:label "Urban Analysis Map"@en ;
    skos:definition "A map-based analytical drawing highlighting spatial patterns, systems, or exceptions at the urban scale."@en .

archdrw:ProcessDiagram
    a archdrw:DrawingType ;
    rdfs:label "Process Diagram"@en ;
    skos:definition "A diagram showing a sequence of analytical or design operations."@en .

archdrw:ExplodedAbstraction
    a archdrw:DrawingType ;
    rdfs:label "Exploded Abstraction"@en ;
    skos:definition "A staged abstraction separating a represented condition into components or levels of simplification."@en .

# â”€â”€ Additional visual element values â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

archdrw:UrbanFabric
    a archdrw:VisualElement ; rdfs:label "Urban Fabric"@en .

archdrw:BuildingFootprints
    a archdrw:VisualElement ; rdfs:label "Building Footprints"@en .

archdrw:Blocks
    a archdrw:VisualElement ; rdfs:label "Urban Blocks"@en .

archdrw:VoidDiagram
    a archdrw:VisualElement ; rdfs:label "Void Diagram"@en .

archdrw:AnomalyHighlight
    a archdrw:VisualElement ; rdfs:label "Anomaly Highlight"@en .

archdrw:LegendKey
    a archdrw:VisualElement ; rdfs:label "Legend / Symbol Key"@en .

archdrw:InsetFrame
    a archdrw:VisualElement ; rdfs:label "Inset Frame / Callout Box"@en .

archdrw:CalloutLine
    a archdrw:VisualElement ; rdfs:label "Callout / Leader Line"@en .

archdrw:TransitLine
    a archdrw:VisualElement ; rdfs:label "Transit Line"@en .

archdrw:RailInfrastructure
    a archdrw:VisualElement ; rdfs:label "Rail Infrastructure"@en .

archdrw:HighwayInfrastructure
    a archdrw:VisualElement ; rdfs:label "Highway Infrastructure"@en .

archdrw:Greenspace
    a archdrw:VisualElement ; rdfs:label "Greenspace"@en .

archdrw:ColorCodedOverlay
    a archdrw:VisualElement ; rdfs:label "Color-Coded Overlay"@en .

archdrw:SequentialDiagramSet
    a archdrw:VisualElement ; rdfs:label "Sequential Diagram Set"@en .

# â”€â”€ Additional building / project program values â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

archdrw:RegionalPlanning
    a archdrw:BuildingProgram ; rdfs:label "Regional Planning"@en .

archdrw:TransitInfrastructure
    a archdrw:BuildingProgram ; rdfs:label "Transit Infrastructure"@en .

archdrw:OpenSpaceNetwork
    a archdrw:BuildingProgram ; rdfs:label "Open Space Network"@en .

# â”€â”€ Controlled instances for common layers / systems â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

archdrw:WaterLayer
    a archdrw:MapLayer ;
    rdfs:label "Water Layer"@en .

archdrw:GreenspaceLayer
    a archdrw:MapLayer ;
    rdfs:label "Greenspace Layer"@en .

archdrw:UrbanFabricLayer
    a archdrw:MapLayer ;
    rdfs:label "Urban Fabric Layer"@en .

archdrw:MajorAnomalyLayer
    a archdrw:MapLayer ;
    rdfs:label "Major Anomaly Layer"@en .

archdrw:MinorAnomalyLayer
    a archdrw:MapLayer ;
    rdfs:label "Minor Anomaly Layer"@en .

archdrw:SurfaceStreetSystem
    a archdrw:ConnectivitySystem ;
    rdfs:label "Surface Street System"@en .

archdrw:UndergroundTransitSystem
    a archdrw:ConnectivitySystem ;
    rdfs:label "Underground Transit System"@en .

archdrw:ElevatedRailSystem
    a archdrw:ConnectivitySystem ;
    rdfs:label "Elevated Rail System"@en .

archdrw:ElevatedHighwaySystem
    a archdrw:ConnectivitySystem ;
    rdfs:label "Elevated Highway System"@en .

archdrw:GreenspaceNetwork
    a archdrw:ConnectivitySystem ;
    rdfs:label "Greenspace Network"@en .

# â”€â”€ Object properties â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

archdrw:hasComponent
    a owl:ObjectProperty ;
    rdfs:domain archdrw:PresentationBoard ;
    rdfs:range archdrw:BoardComponent ;
    rdfs:label "has component"@en ;
    rdfs:comment "Relates a presentation board to one of its constituent components."@en ;
    owl:inverseOf archdrw:isComponentOf .

archdrw:isComponentOf
    a owl:ObjectProperty ;
    rdfs:domain archdrw:BoardComponent ;
    rdfs:range archdrw:PresentationBoard ;
    rdfs:label "is component of"@en ;
    rdfs:comment "Relates a component to the board of which it forms part."@en .

archdrw:containsPanel
    a owl:ObjectProperty ;
    rdfs:domain archdrw:PresentationBoard ;
    rdfs:range archdrw:Panel ;
    rdfs:label "contains panel"@en ;
    rdfs:comment "Specifies that a board contains a panel."@en ;
    rdfs:subPropertyOf archdrw:hasComponent .

archdrw:containsInset
    a owl:ObjectProperty ;
    rdfs:domain archdrw:Panel ;
    rdfs:range archdrw:InsetPanel ;
    rdfs:label "contains inset"@en ;
    rdfs:comment "Specifies that a panel contains an inset or zoomed embedded panel."@en .

archdrw:hasLegend
    a owl:ObjectProperty ;
    rdfs:domain archdrw:PresentationBoard ;
    rdfs:range archdrw:Legend ;
    rdfs:label "has legend"@en ;
    rdfs:comment "Associates a board with a legend or key."@en ;
    rdfs:subPropertyOf archdrw:hasComponent .

archdrw:hasTextBlock
    a owl:ObjectProperty ;
    rdfs:domain archdrw:PresentationBoard ;
    rdfs:range archdrw:TextBlock ;
    rdfs:label "has text block"@en ;
    rdfs:comment "Associates a board with an explanatory text region."@en ;
    rdfs:subPropertyOf archdrw:hasComponent .

archdrw:depictsUrbanEntity
    a owl:ObjectProperty ;
    rdfs:domain archdrw:ArchivalDrawing ;
    rdfs:range archdrw:UrbanEntity ;
    rdfs:label "depicts urban entity"@en ;
    rdfs:comment "Links a drawing to an urban-scale entity, condition, or system it depicts or analyses."@en .

archdrw:identifiesAnomaly
    a owl:ObjectProperty ;
    rdfs:domain archdrw:ArchivalDrawing ;
    rdfs:range archdrw:UrbanAnomaly ;
    rdfs:label "identifies anomaly"@en ;
    rdfs:comment "Links a drawing to an anomaly explicitly identified in the analytical content."@en .

archdrw:showsLayer
    a owl:ObjectProperty ;
    rdfs:domain archdrw:MapPanel ;
    rdfs:range archdrw:MapLayer ;
    rdfs:label "shows layer"@en ;
    rdfs:comment "Indicates that a map panel contains or emphasizes a semantic map layer."@en .

archdrw:highlightsSystem
    a owl:ObjectProperty ;
    rdfs:domain archdrw:ArchivalDrawing ;
    rdfs:range archdrw:ConnectivitySystem ;
    rdfs:label "highlights system"@en ;
    rdfs:comment "Indicates a circulation, landscape, or infrastructure system made explicit in the drawing."@en .

archdrw:abstractsFrom
    a owl:ObjectProperty ;
    rdfs:domain archdrw:AbstractionSequence ;
    rdfs:range archdrw:UrbanEntity ;
    rdfs:label "abstracts from"@en ;
    rdfs:comment "Specifies the source condition or entity from which an abstraction sequence is derived."@en .

archdrw:usesGraphicEncoding
    a owl:ObjectProperty ;
    rdfs:domain archdrw:BoardComponent ;
    rdfs:range archdrw:GraphicEncoding ;
    rdfs:label "uses graphic encoding"@en ;
    rdfs:comment "Relates a board component to the graphic device used to structure or distinguish information."@en .

archdrw:hasSequenceStage
    a owl:ObjectProperty ;
    rdfs:domain archdrw:AbstractionSequence ;
    rdfs:range archdrw:BoardComponent ;
    rdfs:label "has sequence stage"@en ;
    rdfs:comment "Relates an abstraction sequence to one of its stages."@en .

archdrw:precedesStage
    a owl:ObjectProperty ;
    rdfs:domain archdrw:BoardComponent ;
    rdfs:range archdrw:BoardComponent ;
    rdfs:label "precedes stage"@en ;
    rdfs:comment "Specifies ordered succession among stages within a diagrammatic sequence."@en .

# â”€â”€ Datatype properties â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

archdrw:layoutType
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:PresentationBoard ;
    rdfs:range xsd:string ;
    rdfs:label "layout type"@en ;
    rdfs:comment "The overall compositional strategy of the board, for example multi-panel, central-map-with-insets, columnar, or montage."@en .

archdrw:boardOrientation
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:PresentationBoard ;
    rdfs:range xsd:string ;
    rdfs:label "board orientation"@en ;
    rdfs:comment "The overall board orientation, typically portrait, landscape, or square."@en .

archdrw:panelTitle
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:BoardComponent ;
    rdfs:range xsd:string ;
    rdfs:label "panel title"@en ;
    rdfs:comment "A title, heading, or caption printed within a board component."@en .

archdrw:panelOrder
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:BoardComponent ;
    rdfs:range xsd:integer ;
    rdfs:label "panel order"@en ;
    rdfs:comment "Relative ordering of panels or sequence stages within the board composition."@en .

archdrw:spatialScale
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:ArchivalDrawing ;
    rdfs:range xsd:string ;
    rdfs:label "spatial scale"@en ;
    rdfs:comment "The principal geographic or design scale addressed, such as region, city, district, neighborhood, site, or building."@en .

archdrw:analysisFocus
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:ArchivalDrawing ;
    rdfs:range xsd:string ;
    rdfs:label "analysis focus"@en ;
    rdfs:comment "The main analytical concern of the board, such as connectivity, void extraction, infrastructure layering, urban morphology, or circulation."@en .

archdrw:urbanContext
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:ArchivalDrawing ;
    rdfs:range xsd:string ;
    rdfs:label "urban context"@en ;
    rdfs:comment "Urban context descriptors such as gridded city, river corridor, dense fabric, postindustrial landscape, or metropolitan core."@en .

archdrw:hasTextTranscript
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:TextBlock ;
    rdfs:range xsd:string ;
    rdfs:label "has text transcript"@en ;
    rdfs:comment "A transcription of prose or explanatory text visible on the board."@en .

archdrw:legendLabel
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:Legend ;
    rdfs:range xsd:string ;
    rdfs:label "legend label"@en ;
    rdfs:comment "A textual label used in a legend, such as major anomalies or minor anomalies."@en .

archdrw:dominantShape
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:UrbanEntity ;
    rdfs:range xsd:string ;
    rdfs:label "dominant shape"@en ;
    rdfs:comment "A coarse formal descriptor such as linear, branching, clustered, corridor-like, nodal, or fragmented."@en .

archdrw:lineageStep
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:BoardComponent ;
    rdfs:range xsd:string ;
    rdfs:label "lineage step"@en ;
    rdfs:comment "A named step within an abstraction lineage, for example buildings, blocks, void, or abstract."@en .

archdrw:highlightColor
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:GraphicEncoding ;
    rdfs:range xsd:string ;
    rdfs:label "highlight color"@en ;
    rdfs:comment "A named highlight color used semantically in the board, for example red for major anomalies, green for greenspace, blue for water."@en .

archdrw:lineWeightCategory
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:GraphicEncoding ;
    rdfs:range xsd:string ;
    rdfs:label "line weight category"@en ;
    rdfs:comment "A coarse descriptor of line emphasis such as fine, medium, bold, or heavy."@en .

archdrw:usesColorSemantic
    a owl:DatatypeProperty ;
    rdfs:domain archdrw:ArchivalDrawing ;
    rdfs:range xsd:boolean ;
    rdfs:label "uses color semantic"@en ;
    rdfs:comment "Indicates whether color is used semantically to encode different classes of information rather than decoratively alone."@en .


# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# PART II: COMPETITION BRIEFS AND ARCHITECTURAL SUBMISSION BOARDS
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ Classes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

archdrw:CompetitionDocument
    a owl:Class ;
    rdfs:label "Competition Document"@en ;
    rdfs:comment "A textual or graphic archival item associated with a design competition, prize, fellowship, or studio review process."@en ;
    rdfs:subClassOf archdrw:ArchivalItem .

archdrw:CompetitionBrief
    a owl:Class ;
    rdfs:label "Competition Brief"@en ;
    rdfs:comment "A written competition circular or program statement specifying the design problem, site, requirements, submission instructions, and schedule."@en ;
    rdfs:subClassOf archdrw:ArchivalText , archdrw:CompetitionDocument .

archdrw:CompetitionSubmissionBoard
    a owl:Class ;
    rdfs:label "Competition Submission Board"@en ;
    rdfs:comment "A presentation sheet submitted as part of a competition, fellowship, or prize sequence."@en ;
    rdfs:subClassOf archdrw:PresentationBoard , archdrw:CompetitionDocument .

archdrw:ViewPanel
    a owl:Class ;
    rdfs:label "View Panel"@en ;
    rdfs:comment "A panel representing a specific named view, such as a service elevation, street elevation, section, or axonometric."@en ;
    rdfs:subClassOf archdrw:Panel .

archdrw:ElevationPanel
    a owl:Class ;
    rdfs:label "Elevation Panel"@en ;
    rdfs:comment "A panel presenting an elevation view of a building facade or exterior face."@en ;
    rdfs:subClassOf archdrw:ViewPanel .

